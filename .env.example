# Environment Variable Contract Specification for MyAngan

# Node Environment
NODE_ENV=production
PORT=3000
APP_URL=https://myangan.vercel.app
CORS_ALLOWED_ORIGINS=https://myangan.vercel.app,https://myangan.in

# Frontend Public Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_PAYMENTS_ENABLED=false

# Server-Only Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Auth & Cryptography Secrets
OTP_HASH_SECRET=your-32-byte-random-otp-hash-secret

# Payment Gateway Secrets (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Email Delivery Credentials (SMTP / Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=service@myangan.in
SMTP_PASSWORD=your-google-app-password
EMAIL_FROM=MyAngan <service@myangan.in>
EMAIL_REPLY_TO=support@myangan.in

# Server-Only AI Secret
GEMINI_API_KEY=your-google-gemini-api-key
